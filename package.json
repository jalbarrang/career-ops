{
  "name": "career-ops",
  "version": "1.38.0",
  "type": "module",
  "description": "Open-source AI job search that runs locally in your AI coding CLI: scan job portals, evaluate listings into a structured A-H report with a 1-5 score, tailor your CV, track applications",
  "private": true,
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "doctor": "bun doctor.ts",
    "ui": "bun scripts/ui-server.ts",
    "or": "bun openrouter-runner.ts",
    "or:scan": "bun openrouter-runner.ts scan",
    "or:pipeline": "bun openrouter-runner.ts pipeline",
    "or:eval": "bun openrouter-runner.ts evaluate",
    "or:apply": "bun openrouter-runner.ts apply",
    "verify": "bun verify-pipeline.ts",
    "lint": "bun scripts/check-syntax.ts",
    "normalize": "bun normalize-statuses.ts",
    "dedup": "bun dedup-tracker.ts",
    "fix-report-links": "bun fix-report-links.ts",
    "merge": "bun merge-tracker.ts",
    "reconcile": "bun reconcile-pipeline.ts",
    "pdf": "bun generate-pdf.ts",
    "jd:similarity": "bun jd-similarity.ts",
    "img-to-pdf": "bun img-to-pdf.ts",
    "cover-letter": "bun generate-cover-letter.ts --payload",
    "cv:verify-facts": "bun verify-cv-facts.ts",
    "cv:verify-ats": "bun verify-ats.ts",
    "test:cv-visual": "bunx playwright test --config=playwright.cv.config.ts",
    "test:cv-visual:update": "bunx playwright test --config=playwright.cv.config.ts --update-snapshots",
    "sync-check": "bun cv-sync-check.ts",
    "update:check": "bun update-system.ts check",
    "update:test": "bun updater-migration-tests.ts",
    "update": "bun update-system.ts apply --confirm",
    "rollback": "bun update-system.ts rollback",
    "liveness": "bun check-liveness.ts",
    "extract": "bun browser-extract.ts",
    "scan:hn": "bun scan-hn.ts",
    "scan": "bun scan.ts",
    "scan:full": "bun scan-ats-full.ts",
    "scan:seeds": "bun scan-ats-full.ts --seeds yc,a16z",
    "scan:yc": "bun scan-ats-full.ts --seeds yc",
    "scan:interamt": "bun scan-interamt.ts",
    "scan:dayforce": "bun scan-dayforce.ts",
    "company:funded": "bun company-funded.ts",
    "validate:portals": "bun validate-portals.ts",
    "verify:portals": "bun verify-portals.ts",
    "tracker": "bun tracker.ts",
    "find": "bun find.ts",
    "patterns": "bun analyze-patterns.ts",
    "keyword-match": "bun keyword-match.ts",
    "calibrate": "bun calibrate.ts",
    "upskill": "bun upskill.ts",
    "career-profile": "bun career-profile.ts",
    "add": "bun add-entry.ts",
    "reposts": "bun detect-reposts.ts",
    "filter-audit": "bun filter-audit.ts --summary",
    "digest": "bun weekly-digest.ts",
    "freshness": "bun check-table-freshness.ts",
    "jd-archive": "bun check-jd-archive.ts",
    "rejection-latency": "bun rejection-latency.ts",
    "closing-soon": "bun closing-soon.ts",
    "reeval-candidates": "bun reeval-candidates.ts",
    "invite-match": "bun invite-match.ts",
    "ics-interview": "bun ics-interview.ts",
    "paste-reply": "bun paste-reply.ts",
    "gemini:eval": "bun gemini-eval.ts",
    "ollama:eval": "bun ollama-eval.ts",
    "openai:eval": "bun openai-eval.ts",
    "openai:tailor": "bun openai-tailor.ts",
    "eval:golden": "bun eval-golden.ts",
    "star": "bun match-star.ts",
    "archive": "bun archive-posting.ts",
    "prepare:application": "bun prepare-application.ts",
    "application:init": "bun application-artifacts.ts --init",
    "build:dashboard": "bun build-dashboard.ts",
    "serve:dashboard": "cd dashboard && go run .",
    "postinstall": "bun -e \"process.exit(['','0','false'].includes((process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD||'').toLowerCase())?1:0)\" || bunx playwright install chromium || bunx playwright install chromium || bun -e \"console.warn('\\ncareer-ops: could not install Playwright Chromium. Everything else is installed; PDF generation and browser checks need it. Run: bunx playwright install chromium')\"",
    "manifesto": "bun manifesto.ts"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fern\u00e1ndez de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://career-ops.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/career-ops-hq/career-ops"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^18.0.4",
    "js-yaml": "^5.3.0",
    "playwright": "1.64.1",
    "undici": "^6.28.1"
  },
  "packageManager": "bun@1.4.3",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "typescript": "5"
  }
}
