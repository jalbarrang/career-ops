{
  "name": "career-ops",
  "version": "1.38.0",
  "private": true,
  "type": "module",
  "description": "Open-source AI job search that runs locally in your AI coding CLI: scan job portals, evaluate listings into a structured A-H report with a 1-5 score, tailor your CV, track applications",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "career-ops": "bun packages/cli/src/bin/career-ops.ts",
    "test": "bun test-all.ts --quick",
    "doctor": "bun packages/cli/src/commands/platform/doctor.ts",
    "ui": "bun scripts/ui-server.ts",
    "or": "bun packages/cli/src/commands/evaluation/openrouter-runner.ts",
    "or:scan": "bun packages/cli/src/commands/evaluation/openrouter-runner.ts scan",
    "or:pipeline": "bun packages/cli/src/commands/evaluation/openrouter-runner.ts pipeline",
    "or:eval": "bun packages/cli/src/commands/evaluation/openrouter-runner.ts evaluate",
    "or:apply": "bun packages/cli/src/commands/evaluation/openrouter-runner.ts apply",
    "verify": "bun packages/cli/src/commands/platform/verify-pipeline.ts",
    "lint": "bun scripts/check-syntax.ts",
    "normalize": "bun packages/cli/src/commands/tracker/normalize-statuses.ts",
    "dedup": "bun packages/cli/src/commands/tracker/dedup-tracker.ts",
    "fix-report-links": "bun packages/cli/src/commands/tracker/fix-report-links.ts",
    "merge": "bun packages/cli/src/commands/tracker/merge-tracker.ts",
    "reconcile": "bun packages/cli/src/commands/pipeline/reconcile-pipeline.ts",
    "pdf": "bun packages/cli/src/commands/cv/generate-pdf.ts",
    "jd:similarity": "bun packages/cli/src/commands/evaluation/jd-similarity.ts",
    "img-to-pdf": "bun packages/cli/src/commands/cv/img-to-pdf.ts",
    "cover-letter": "bun packages/cli/src/commands/cv/generate-cover-letter.ts --payload",
    "cv:verify-facts": "bun packages/cli/src/commands/cv/verify-cv-facts.ts",
    "cv:verify-ats": "bun packages/cli/src/commands/cv/verify-ats.ts",
    "test:cv-visual": "bunx playwright test --config=playwright.cv.config.ts",
    "test:cv-visual:update": "bunx playwright test --config=playwright.cv.config.ts --update-snapshots",
    "sync-check": "bun packages/cli/src/commands/cv/cv-sync-check.ts",
    "update:check": "bun packages/cli/src/commands/platform/update-system.ts check",
    "update:test": "bun updater-migration-tests.ts",
    "update": "bun packages/cli/src/commands/platform/update-system.ts apply --confirm",
    "rollback": "bun packages/cli/src/commands/platform/update-system.ts rollback",
    "liveness": "bun packages/cli/src/commands/liveness/check-liveness.ts",
    "extract": "bun packages/cli/src/commands/scanning/browser-extract.ts",
    "scan:hn": "bun packages/cli/src/commands/scanning/scan-hn.ts",
    "scan": "bun packages/core/src/scanning/scan.ts",
    "scan:full": "bun packages/cli/src/commands/scanning/scan-ats-full.ts",
    "scan:seeds": "bun packages/cli/src/commands/scanning/scan-ats-full.ts --seeds yc,a16z",
    "scan:yc": "bun packages/cli/src/commands/scanning/scan-ats-full.ts --seeds yc",
    "scan:interamt": "bun packages/cli/src/commands/scanning/scan-interamt.ts",
    "scan:dayforce": "bun packages/cli/src/commands/scanning/scan-dayforce.ts",
    "company:funded": "bun packages/cli/src/commands/scanning/company-funded.ts",
    "validate:portals": "bun packages/cli/src/commands/scanning/validate-portals.ts",
    "verify:portals": "bun packages/core/src/scanning/verify-portals.ts",
    "tracker": "bun packages/cli/src/commands/tracker/tracker.ts",
    "find": "bun packages/cli/src/commands/pipeline/find.ts",
    "patterns": "bun packages/cli/src/commands/insights/analyze-patterns.ts",
    "keyword-match": "bun packages/cli/src/commands/evaluation/keyword-match.ts",
    "calibrate": "bun packages/cli/src/commands/insights/calibrate.ts",
    "upskill": "bun packages/cli/src/commands/insights/upskill.ts",
    "career-profile": "bun packages/cli/src/commands/profile/career-profile.ts",
    "add": "bun packages/cli/src/commands/cv/add-entry.ts",
    "reposts": "bun packages/cli/src/commands/insights/detect-reposts.ts",
    "filter-audit": "bun packages/cli/src/commands/scanning/filter-audit.ts --summary",
    "digest": "bun packages/cli/src/commands/interview/weekly-digest.ts",
    "freshness": "bun packages/cli/src/commands/platform/check-table-freshness.ts",
    "jd-archive": "bun packages/core/src/evaluation/check-jd-archive.ts",
    "rejection-latency": "bun packages/cli/src/commands/outreach/rejection-latency.ts",
    "closing-soon": "bun packages/cli/src/commands/insights/closing-soon.ts",
    "reeval-candidates": "bun packages/cli/src/commands/insights/reeval-candidates.ts",
    "invite-match": "bun packages/core/src/interview/invite-match.ts",
    "ics-interview": "bun packages/cli/src/commands/interview/ics-interview.ts",
    "paste-reply": "bun packages/cli/src/commands/outreach/paste-reply.ts",
    "gemini:eval": "bun packages/cli/src/commands/evaluation/gemini-eval.ts",
    "ollama:eval": "bun packages/cli/src/commands/evaluation/ollama-eval.ts",
    "openai:eval": "bun packages/cli/src/commands/evaluation/openai-eval.ts",
    "openai:tailor": "bun packages/cli/src/commands/cv/openai-tailor.ts",
    "eval:golden": "bun packages/cli/src/commands/evaluation/eval-golden.ts",
    "star": "bun packages/cli/src/commands/interview/match-star.ts",
    "archive": "bun packages/cli/src/commands/evaluation/archive-posting.ts",
    "prepare:application": "bun packages/cli/src/commands/evaluation/prepare-application.ts",
    "application:init": "bun packages/cli/src/commands/evaluation/application-artifacts.ts --init",
    "build:dashboard": "bun packages/cli/src/commands/platform/build-dashboard.ts",
    "serve:dashboard": "cd dashboard && go run .",
    "postinstall": "bun -e \"process.exit(['','0','false'].includes((process.env.PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD||'').toLowerCase())?1:0)\" || bunx playwright install chromium || bunx playwright install chromium || bun -e \"console.warn('\\ncareer-ops: could not install Playwright Chromium. Everything else is installed; PDF generation and browser checks need it. Run: bunx playwright install chromium')\"",
    "manifesto": "bun packages/cli/src/commands/platform/manifesto.ts"
  },
  "keywords": [
    "ai",
    "job-search",
    "claude-code",
    "opencode",
    "career",
    "career-ops",
    "careerops",
    "automation",
    "codex",
    "antigravity",
    "qwen",
    "kimi",
    "copilot",
    "grok",
    "ai-agent-skill"
  ],
  "author": "Santiago Fernández de Valderrama <hi@santifer.io> (https://santifer.io)",
  "homepage": "https://career-ops.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/career-ops-hq/career-ops"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.4",
    "playwright": "1.64.1",
    "typescript": "5"
  },
  "packageManager": "bun@1.4.3"
}
