{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "schedule": ["before 7am on monday"],
  "prHourlyLimit": 3,
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies",
      "automerge": false
    },
    {
      "matchManagers": ["npm"],
      "groupName": "bun dependencies",
      "automerge": false
    },
    {
      "description": "test.yml pins the project's Bun floor (lib/bun-floor.ts); bumping it silently drops the floor from CI, as 647ab019 did with the old Node floor. Raise it by hand together with BUN_MIN.",
      "matchFileNames": [".github/workflows/test.yml"],
      "matchDatasources": ["node-version"],
      "enabled": false
    }
  ]
}
