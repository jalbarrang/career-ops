{
  "name": "@career-ops/web",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "description": "Official web experience for career-ops — local-first.",
  "engines": {
    "node": ">=22.17.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node server.mjs dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.mjs start",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.mjs\"",
    "check:i18n": "inlang check --project ./project.inlang",
    "pretypecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent"
  },
  "dependencies": {
    "@lucide/svelte": "^1.66.0",
    "@paper-design/shaders": "^0.0.82",
    "bits-ui": "^2.20.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "js-yaml": "^4.1.0",
    "marked": "^18.1.3",
    "playwright-core": "^1.61.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@inlang/cli": "^3.4.0",
    "@inlang/paraglide-js": "^3.0.0",
    "@inlang/plugin-m-function-matcher": "^2.3.0",
    "@inlang/plugin-message-format": "^4.5.7",
    "@internationalized/date": "^3.12.4",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "shadcn-svelte": "^1.7.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
